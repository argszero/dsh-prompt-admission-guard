{
  "name": "@argszero/dsh-prompt-admission-guard",
  "version": "0.1.0",
  "description": "A host-side admission filter for person-originated prompts. The inbox writes `agent/inbox/spliced` before any listener runs, so a prompt a plugin recognises and would refuse is already in the durable log by the time `agent/inbox/inserted` fires; `agent/pre-step` can keep it from the model, never from the Session record. This plugin takes the durable log's single acceptance boundary — `Session.append` — and fans it out to a registry of synchronous filters, so a refusal happens before the row exists and the sender reads the refusal text. Answers discussion #14022.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argszero/dsh-prompt-admission-guard.git"
  },
  "homepage": "https://github.com/argszero/dsh-prompt-admission-guard#readme",
  "bugs": {
    "url": "https://github.com/argszero/dsh-prompt-admission-guard/issues"
  },
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "plugin",
    "prompt",
    "admission",
    "guard",
    "session"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "tsc",
    "test": "node --test \"test/*.spec.mjs\"",
    "prepublishOnly": "tsc"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || >=4.0.5-alpha.1 <5",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.3 <0.2.2 || >=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
